# Copy to backend/.env and edit. Real environment variables override this file.
# Every setting Syncra reads is listed here (see app/core/config.py).
# The same file serves local development (make run / make worker) and the production
# docker compose (which overrides DATABASE_URL and OLLAMA_BASE_URL with the service names).

# --- Database (local development): your own PostgreSQL 16+ with the pgvector extension ---
# Homebrew Postgres: USER is your macOS user name (created as superuser, no password).
DATABASE_URL=postgresql+psycopg://USER@localhost:5434/syncra
# A database on another host must use TLS: append ?sslmode=require (or verify-full) to the URL.

# --- Database (production docker compose) ---
POSTGRES_USER=syncra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=syncra
POSTGRES_PORT=5432
API_PORT=8000

# --- Ollama: native install locally; the `ollama` service in production ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
# Chat calls give up sooner: a user is waiting
CHAT_TIMEOUT_SECONDS=30
# How long Ollama keeps a model loaded after a call (reloading qwen3:8b takes seconds)
OLLAMA_KEEP_ALIVE=30m
# Load the chat's models when the API starts, so the first question isn't slow
WARM_UP=true

# --- Hugging Face ---
HF_TOKEN=
# Where Hugging Face models run: auto (GPU if available) | cpu | mps | cuda
DEVICE=auto
# Where `make train-triage` / `make train-intent-router` save the classifiers. Empty = backend/models
TRAINED_MODELS_DIR=

# --- Data sources (fill in the ones you connect) ---
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_URL=
SLACK_API_URL=https://slack.com/api
SLACK_THREAD_LOOKBACK_DAYS=7

# --- Key numbers (description.md §9) ---
SYNC_INTERVAL_MINUTES=15
CHAT_MEMORY_TURNS=10
TOP_K_EVIDENCE=8
EMBEDDING_DIM=1024

# --- Chunker: chunk size and overlap in characters (~4 per token) ---
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# --- Decision reader (characters): skip shorter conversations, cut longer ones in the middle ---
DECISION_MIN_CHARS=60
DECISION_MAX_CHARS=6000

# --- Chat: the longest message a user may send, in characters ---
CHAT_MESSAGE_MAX_CHARS=4000

# --- Question rewriter / answer writer: send at most this many characters of chat history ---
REWRITER_MAX_CHARS=4000
ANSWER_HISTORY_MAX_CHARS=2000

# --- Search: each search (vector, keyword, graph) returns this many before reranking to TOP_K_EVIDENCE ---
SEARCH_CANDIDATES=20

# --- Confidence: support x relevance at least HIGH -> high, at least MEDIUM -> medium, else low ---
CONFIDENCE_HIGH=0.7
CONFIDENCE_MEDIUM=0.4

# --- Login: hours until a login token stops working ---
TOKEN_TTL_HOURS=12

# --- Monitoring: answers slower than this show up in GET /admin/status; events kept this many days ---
SLOW_ANSWER_SECONDS=10
EVENTS_KEEP_DAYS=30

# --- Misc ---
LOG_LEVEL=INFO
# text, or json for one JSON object per log line (log collectors)
LOG_FORMAT=text
# API documentation: Swagger UI at /docs, ReDoc at /redoc. Handy locally; production forces it off.
API_DOCS=true
