# Copy to backend/.env and edit. Real environment variables override this file.
# Every setting Syncra reads is listed here (see app/config/settings.py).

# --- Database: docker compose Postgres + pgvector ---
# Host port 5436 so it does not clash with the Postgres servers already on 5432-5435 on the dev machine.
POSTGRES_USER=syncra
POSTGRES_PASSWORD=syncra
POSTGRES_DB=syncra
POSTGRES_PORT=5436
DATABASE_URL=postgresql+psycopg://syncra:syncra@localhost:5436/syncra
# `make test` uses its own database (created by scripts/init_db.sql), never DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://syncra:syncra@localhost:5436/syncra_test

# --- Ollama: native install on macOS, or `docker compose --profile ollama up` on Linux ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_PORT=11434

# --- Hugging Face: token only needed for gated models (Prompt Guard 2) ---
HF_TOKEN=

# --- Key numbers (description.md §9) ---
SYNC_INTERVAL_MINUTES=15
CHAT_MEMORY_TURNS=10
TOP_K_EVIDENCE=8
EMBEDDING_DIM=1024

# --- Misc ---
LOG_LEVEL=INFO
